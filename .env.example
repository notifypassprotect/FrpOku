PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
REQUEST_BODY_LIMIT=15mb

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ENABLE_BROWSER_SUPABASE=false
SESSION_SECRET=generate-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=staging-admin
BOOTSTRAP_ADMIN_PASSWORD=generate-at-least-12-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Staging ortaminda tum uygulamayi HTTP Basic Auth ile korur.
STAGING_ACCESS_ENABLED=false
STAGING_ACCESS_USER=staging-user
STAGING_ACCESS_PASSWORD=generate-a-strong-password

# Google Workspace / Gmail App Password ile SMTP
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="FrpOku Cloud Portal <your-email@gmail.com>"
